*#
*~
admin/
src/burrTxt
src/burrTxt2
src/gui/burrGui
src/help/helpviewer
src/unitTest
build/
build-*/
GPATH
GRTAGS
GTAGS

# Meson subprojects (keep only .wrap files in git)
subprojects/*
!subprojects/*.wrap

# macOS build artifacts
*.dmg
*.app
dmg_contents/
coverage-html/

# macOS Finder metadata, written into any directory the user opens in Finder
.DS_Store

# Generated Doxygen API reference (`just docs`)
gendoc/

# Python artifacts
__pycache__/
*.pyc

# Local generated test output
*.stl
puzzles/

# Benchmark and profiling outputs
bench/**/*.csv
bench_run.log
callgrind*.out*
perf.data*

# new ui
artifacts/*
# design-spec: only the written spec is kept. BurrTools-SPEC-FULL-FINAL-v6.md
# holds every document of the spec bundle in one file (each part marked
# <!-- FILE: path -->); the bundle's separate copies, the HTML mock and the
# assets stay out -- the glyphs, icons and design tokens the GUI uses are in
# src/qtgui/resources.
design-spec/*
!design-spec/BurrTools-SPEC-FULL-FINAL-v6.md
!design-spec/gui-migration.md
.vscode/
.claude/settings.local.json
.cache
