# The QML module BurrTools.Ui: the QML files of the redesigned GUI plus the
# C++ types they use. It is declared here, next to the QML files, so they sit
# at the module root -- loadFromModule("BurrTools.Ui", "Main") finds Main.qml
# under its own name, not under a "qml/" prefix.

qtgui_qmlmod = qt6.qml_module('BurrTools.Ui',
  version: '1.0',
  qml_sources: files(
    'AboutDialog.qml',
    'AppMenu.qml',
    'AppMenuBar.qml',
    'AppMenuItem.qml',
    'BtButton.qml',
    'BtCheckBox.qml',
    'BtDialog.qml',
    'BtSlider.qml',
    'BtSwitch.qml',
    'BtToolTip.qml',
    'Card.qml',
    'CheckRow.qml',
    'CollapsedRail.qml',
    'CommandMenu.qml',
    'CommentDialog.qml',
    'ConvertDialog.qml',
    'DecimalField.qml',
    'DisplayMenu.qml',
    'Dropdown.qml',
    'Gallery.qml',
    'Glyph.qml',
    'Icon.qml',
    'IconButton.qml',
    'ImageExportDialog.qml',
    'ImportAssembliesDialog.qml',
    'KeyBadge.qml',
    'KeyboardShortcutsDialog.qml',
    'Main.qml',
    'NewFileDialog.qml',
    'NumberField.qml',
    'PlaceholderCard.qml',
    'ProblemList.qml',
    'RadioCard.qml',
    'RailButton.qml',
    'SearchField.qml',
    'Segmented.qml',
    'SettingsDialog.qml',
    'ShapesCard.qml',
    'ShortcutKeys.qml',
    'StatusBar.qml',
    'StatusDialog.qml',
    'StlExportDialog.qml',
    'ToolbarButton.qml',
    'VectorExportDialog.qml',
    'ViewportCard.qml',
    'VoxelEditorCard.qml',
    'WorkspaceRail.qml',
  ),
  moc_headers: qtgui_moc_headers,
  include_directories: [inc, include_directories('..')],
  imports: ['QtQuick', 'QtQuick.Controls', 'QtQuick.Layouts', 'QtQuick.Dialogs'],
  rcc_extra_arguments: qt_rcc_args,
  dependencies: qt6_dep,
)
