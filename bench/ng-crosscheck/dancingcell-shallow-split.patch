+        // prototype: split off the untried remainder of the shallowest open branching frame
+        std::unique_ptr<MCCSolver> splitShallow()
+        {
+            size_t k = floorFrames;
+            while (k < activeFrames && !(frames[k].state == 3 && !frames[k].given)) k++;
+            if (k + 1 >= activeFrames) return nullptr;
+
+            auto res = std::make_unique<DancingCellSolver>(*this);
+            while (res->activeFrames - 1 > k)
+            {
+                auto & f = res->topFrame();
+                switch (f.state)
+                {
+                    case 2: res->SOL.resize(f.f); break;
+                    case 3: res->SOL.pop_back(); res->restoreItemSetSizes(f.storestate); break;
+                    default: break;
+                }
+                res->popFrame();
+            }
+            {
+                auto & f = res->topFrame();
+                res->SOL.pop_back();
+                res->restoreItemSetSizes(f.storestate);
+                res->discardOption(f.x);
+                f.state = 1;
+                res->pushFrame();
+            }
+            res->floorFrames = k;
+            frames[k].given  = true;
+            return res;
+        }
 
