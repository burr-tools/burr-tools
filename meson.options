option('python', type: 'feature', value: 'auto', description: 'Build Python wrapper module')
option('qt_gui', type: 'feature', value: 'auto', description: 'Build burrtools-qt, the redesigned Qt 6 Quick GUI (needs Qt >= 6.8)')
option('macos_deployment_target', type: 'string', value: '11.0', description: 'Oldest macOS the legacy binaries (burrtools, burrTxt) run on')
option('qt_macos_deployment_target', type: 'string', value: '14.0', description: 'Oldest macOS burrtools-qt runs on; raised to what Qt\'s frameworks need when that is later (Homebrew\'s Qt targets the macOS it was built on)')
option('qml_debug', type: 'boolean', value: false, description: 'Let qmlprofiler and the QML debugger attach to burrtools-qt (QT_QML_DEBUG); for profiling builds, never a release')
option('qt_static', type: 'boolean', value: false, description: 'Link burrtools-qt with a static Qt (found through its qmake, e.g. MSYS2 qt6-static) into one standalone program; the Qt tests are not built')
option('dxbc', type: 'feature', value: 'auto', description: 'Ship burrtools-qt\'s Direct3D shaders compiled (DXBC, by the Windows SDK\'s fxc) instead of as HLSL source Direct3D compiles at start-up; Windows only')
